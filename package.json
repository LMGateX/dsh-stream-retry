{
  "name": "dsh-stream-retry",
  "version": "0.1.4",
  "description": "Configurable stream error classification for DSH built-in request retry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMGateX/dsh-stream-retry.git"
  },
  "bugs": {
    "url": "https://github.com/LMGateX/dsh-stream-retry/issues"
  },
  "homepage": "https://github.com/LMGateX/dsh-stream-retry#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./client/public.d.ts",
      "default": "./client/client.js"
    },
    "./client-types": {
      "types": "./client/public.d.ts",
      "default": "./client/public.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.backend.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "npm run typecheck && npm run build && npm run test:unit",
    "test:unit": "node --test test/plugin.test.ts test/client.test.ts",
    "test:integration": "node --test test/integration.test.ts",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
