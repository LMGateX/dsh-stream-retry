{
  "name": "dsh-stream-retry",
  "version": "0.1.0",
  "description": "Configurable stream error classification for DSH built-in request retry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMGateX/dsh-stream-retry.git"
  },
  "bugs": {
    "url": "https://github.com/LMGateX/dsh-stream-retry/issues"
  },
  "homepage": "https://github.com/LMGateX/dsh-stream-retry#readme",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "matcher.js",
    "cordis.patch.yml",
    "client.js",
    "locale",
    "README.md",
    "LICENSE",
    "test"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/plugin.test.mjs test/client.test.mjs test/integration.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "check": "node --check index.js && node --check matcher.js && node --check client.js",
    "test:unit": "node --test test/plugin.test.mjs test/client.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
