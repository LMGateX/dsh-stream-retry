{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": ".",
    "rootDir": ".",
    // The browser half is injected as a classic script and concatenated with other
    // bundles, so it must compile as a script: no ESM syntax, no `export {}` marker.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "target": "ES2024"
  },
  "include": [
    "client/**/*.ts",
    "types/**/*.d.ts"
  ]
}
